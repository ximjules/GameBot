rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUserDocument(userId);

      match /games/{gameId} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }

      match /events/{eventId} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }

      match /notes/{noteId} {
        allow read, create, update, delete: if ownsUserDocument(userId);
      }
    }

    match /communityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /publicEvents/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /setups/{setupId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
